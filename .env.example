# Copy this file to ".env" and fill in your own key. Never commit ".env".

# Free key from https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your-gemini-api-key-here

# Models are configurable so you can swap them without touching code.
# Check the current model names in Google AI Studio if a call returns "model not found".
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional tuning (defaults shown)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
FETCH_TIMEOUT_SECONDS=12
MAX_EXTRA_PAGES=2
MAX_CONTENT_CHARS=14000
CACHE_TTL_SECONDS=3600

# Per-IP requests per minute for /link-analysis (protects your free quota). 0 = off.
RATE_LIMIT_PER_MINUTE=10
